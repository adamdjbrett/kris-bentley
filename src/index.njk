  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; background: #ffffff; color: #1e2d36; }

    /* ── Bracket motif (signature element) ── */
    .bracket-frame {
      position: relative;
      display: inline-block;
    }
    .bracket-frame::before,
    .bracket-frame::after {
      content: '';
      position: absolute;
      width: 28px;
      height: 28px;
      border-color: #F0D478;
      border-style: solid;
    }
    .bracket-frame::before {
      top: -6px; left: -6px;
      border-width: 2px 0 0 2px;
    }
    .bracket-frame::after {
      bottom: -6px; right: -6px;
      border-width: 0 2px 2px 0;
    }

    /* ── Bracket accent for section headings ── */
    .section-bracket {
      position: relative;
      padding-left: 1.5rem;
    }
    .section-bracket::before {
      content: '';
      position: absolute;
      left: 0; top: 4px; bottom: 4px;
      width: 3px;
      background: #5CA0BF;
      border-radius: 2px;
    }

    /* ── Nav link hover ── */
    .nav-link {
      position: relative;
      color: #a8cfe0;
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      font-weight: 400;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      transition: color 0.2s;
      text-decoration: none;
    }
    .nav-link:hover { color: #F0D478; }
    .nav-link.active { color: #F0D478; }

    /* ── Blog card hover ── */
    .blog-card {
      border: 1px solid #e8eef2;
      border-radius: 4px;
      overflow: hidden;
      transition: box-shadow 0.2s, border-color 0.2s, transform 0.2s;
      background: #ffffff;
    }
    .blog-card:hover {
      border-color: #5CA0BF;
      box-shadow: 0 6px 24px rgba(55,91,112,0.10);
      transform: translateY(-2px);
    }

    /* ── Tag pill ── */
    .tag-pill {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 500;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 2px;
    }

    /* ── CTA button ── */
    .btn-cta {
      background: #C26E40;
      color: #ffffff;
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      padding: 0.75rem 2rem;
      border-radius: 2px;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
      display: inline-block;
    }
    .btn-cta:hover { background: #a05530; transform: translateY(-1px); }

    /* ── Secondary button ── */
    .btn-outline {
      background: transparent;
      color: #F0D478;
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      padding: 0.7rem 1.8rem;
      border-radius: 2px;
      border: 1.5px solid #F0D478;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, color 0.2s;
      display: inline-block;
    }
    .btn-outline:hover { background: #F0D478; color: #263f4e; }

    /* ── Prose link ── */
    .prose-link {
      color: #5CA0BF;
      text-decoration: none;
      border-bottom: 1px solid transparent;
      transition: border-color 0.15s;
    }
    .prose-link:hover { border-color: #5CA0BF; }

    /* ── Newsletter input ── */
    .email-input {
      border: 1.5px solid rgba(255,255,255,0.25);
      background: rgba(255,255,255,0.08);
      color: #ffffff;
      padding: 0.72rem 1rem;
      border-radius: 2px;
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      width: 100%;
      outline: none;
      transition: border-color 0.2s;
    }
    .email-input::placeholder { color: rgba(255,255,255,0.45); }
    .email-input:focus { border-color: #F0D478; }

    /* ── Section divider ── */
    .divider {
      width: 48px;
      height: 2px;
      background: #5CA0BF;
      border-radius: 1px;
      margin: 1.25rem 0;
    }

    /* ── Quote block ── */
    .pull-quote {
      border-left: 3px solid #F0D478;
      padding-left: 1.5rem;
      font-family: 'Cormorant Garamond', serif;
      font-style: italic;
      font-size: 1.35rem;
      line-height: 1.6;
      color: #375B70;
    }

    /* ── Scroll reveal (lightweight) ── */
    .reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal { opacity: 1; transform: none; transition: none; }
      .blog-card { transition: none; }
      .btn-cta, .btn-outline { transition: none; }
    }

    @media (max-width: 768px) {
      .hero-grid { flex-direction: column; }
      .hero-book  { display: none; }
    }
  </style>
</head>
