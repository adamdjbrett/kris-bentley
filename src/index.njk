<style>
  .filter-btn {
    font-family:'Inter',sans-serif;
    font-size:0.78rem;
    font-weight:500;
    letter-spacing:0.04em;
    padding:0.4rem 1rem;
    border-radius:2px;
    border:1px solid #cbd5e1;
    background:#ffffff;
    color:#64748b;
    cursor:pointer;
    transition:background 0.15s, color 0.15s, border-color 0.15s;
  }
  .filter-btn:hover { border-color:#375B70; color:#375B70; }
  .filter-btn.active-filter { background:#375B70; color:#ffffff; border-color:#375B70; }
</style>


<!-- ══════════════════════════════════════════
     JAVASCRIPT
══════════════════════════════════════════ -->
<script>
  /* ── Mobile nav toggle ── */
  function toggleMenu() {
    var menu = document.getElementById('mobile-menu');
    menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
  }

  /* ── Blog filter ── */
  function filterPosts(category) {
    var cards = document.querySelectorAll('#posts-grid .blog-card');
    var btns  = document.querySelectorAll('.filter-btn');

    btns.forEach(function(btn) {
      btn.classList.toggle('active-filter', btn.dataset.filter === category);
    });

    cards.forEach(function(card) {
      if (category === 'all' || card.dataset.category === category) {
        card.style.display = 'flex';
        card.style.flexDirection = 'column';
      } else {
        card.style.display = 'none';
      }
    });
  }

  /* ── Newsletter subscribe ── */
  function handleSubscribe() {
    var input   = document.getElementById('email-input');
    var form    = document.getElementById('subscribe-form');
    var success = document.getElementById('subscribe-success');

    if (!input.value || !input.value.includes('@')) {
      input.style.borderColor = '#C26E40';
      input.focus();
      return;
    }

    form.style.display = 'none';
    success.style.display = 'block';
  }

  /* ── Load more (stub) ── */
  function loadMore() {
    var btn = event.target;
    btn.textContent = 'All posts loaded';
    btn.disabled = true;
    btn.style.opacity = '0.5';
    btn.style.cursor = 'default';
  }

  /* ── Scroll reveal ── */
  var revealObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.reveal').forEach(function(el) {
    revealObserver.observe(el);
  });

  /* ── Smooth scroll ── */
  document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
    anchor.addEventListener('click', function(e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

