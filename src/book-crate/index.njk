---
layout: false
permalink: /book-crate/
title: Book Crate
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }} | Kristen Plinke Bentley</title>
  <style>
    :root {
      --ink: #1e2d36;
      --teal: #375b70;
      --teal-dark: #263f4e;
      --teal-light: #5ca0bf;
      --gold: #f0d478;
      --paper: #f7fafc;
      --card: #ffffff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--ink);
      font-family: "Inter", system-ui, -apple-system, sans-serif;
      background:
        radial-gradient(circle at 10% 5%, rgba(92,160,191,0.1) 0%, transparent 38%),
        radial-gradient(circle at 90% 15%, rgba(240,212,120,0.2) 0%, transparent 32%),
        var(--paper);
      line-height: 1.6;
    }
    .topbar {
      background: linear-gradient(90deg, var(--teal-dark), var(--teal));
      color: #fff;
      padding: 0.85rem 1.25rem;
    }
    .topbar a {
      color: #fff;
      text-decoration: none;
      font-weight: 600;
      letter-spacing: 0.03em;
    }
    .wrap {
      max-width: 980px;
      margin: 0 auto;
      padding: 2.5rem 1.25rem 4rem;
    }
    h1 {
      margin: 0;
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: clamp(2.3rem, 5vw, 3.5rem);
      color: var(--teal-dark);
      line-height: 1.1;
    }
    .intro {
      max-width: 720px;
      margin: 0.9rem 0 1.8rem;
      color: #304d60;
      font-size: 1.05rem;
    }
    .filter-note {
      display: inline-block;
      margin: 0 0 1.8rem;
      background: #fff8de;
      border: 1px solid #f3dd8c;
      color: #5d4b11;
      padding: 0.35rem 0.6rem;
      border-radius: 4px;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 600;
    }
    .grid {
      display: grid;
      gap: 1rem;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
    .card {
      background: var(--card);
      border: 1px solid #dce8ef;
      border-radius: 8px;
      padding: 1rem;
      box-shadow: 0 8px 26px rgba(38,63,78,0.06);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 30px rgba(38,63,78,0.12);
    }
    .card h2 {
      margin: 0 0 0.5rem;
      font-size: 1.25rem;
      line-height: 1.25;
      color: var(--teal-dark);
      font-family: "Cormorant Garamond", Georgia, serif;
    }
    .card h2 a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid transparent;
    }
    .card h2 a:hover {
      border-color: var(--teal-light);
    }
    .meta {
      margin: 0 0 0.7rem;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #557386;
      font-weight: 600;
    }
    .desc {
      margin: 0 0 0.7rem;
      font-size: 0.95rem;
      color: #35576d;
    }
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }
    .tag {
      display: inline-block;
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      border: 1px solid #c8dce6;
      padding: 0.2rem 0.5rem;
      border-radius: 999px;
      color: #35576d;
      background: #f3f9fc;
    }
  </style>
</head>
<body>
  <header class="topbar">
    <a href="/">Kristen Plinke Bentley</a>
  </header>

  <main class="wrap">
    <h1>Book Crate</h1>
    <p class="intro">A book review collection for congregational leaders, teachers, and readers who want to grow deeper in faith and life conversations.</p>
    <p class="filter-note">Tag Filter: book-crate</p>

    {% if collections.bookCrate.length %}
      <section class="grid" aria-label="Book Crate entries">
        {% for post in collections.bookCrate %}
          <article class="card">
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            <p class="meta">ISBN: {{ post.data.isbn }}</p>
            <p class="desc">{{ post.data.description }}</p>
            {% if post.data.tags %}
              <div class="tags">
                {% for tag in post.data.tags %}
                  {% if tag != "all" and tag != "book-crate" %}
                    <span class="tag">{{ tag }}</span>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </section>
    {% else %}
      <p>No book reviews have been added yet.</p>
    {% endif %}
  </main>
</body>
</html>
