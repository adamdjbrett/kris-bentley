<section id="contact" style="background:#375B70; padding:5rem 2rem;">
  <div style="max-width:600px; margin:0 auto; text-align:center;">
    <!-- Bracket motif (decorative) -->
    <div style="display:flex; align-items:center; justify-content:center; gap:0.75rem; margin-bottom:1.5rem;">
      <div style="width:20px; height:20px; border-top:1.5px solid #F0D478; border-left:1.5px solid #F0D478;"></div>
      <p style="font-family:'Inter',sans-serif; font-size:0.75rem; letter-spacing:0.12em; text-transform:uppercase; color:#5CA0BF; margin:0;">{{metadata.newsletter.info}}</p>
      <div style="width:20px; height:20px; border-bottom:1.5px solid #F0D478; border-right:1.5px solid #F0D478;"></div>
    </div>

    <h2 style="font-family:'Cormorant Garamond',serif; font-size:2.4rem; font-weight:300; color:#ffffff; margin:0 0 0.75rem; line-height:1.2;">
      {{metadata.newsletter.title}}<br><em style="color:#F0D478;">{{metadata.newsletter.span}}</em>
    </h2>
    <p style="font-family:'Inter',sans-serif; font-size:0.95rem; line-height:1.75; color:rgba(255,255,255,0.65); margin:0 0 2rem;">
      {{metadata.newsletter.text}}
    </p>

    <!-- Formspree form -->
   <form action="{{metadata.formspree_id}}" method="POST" style="display:flex; flex-direction:column; gap:0.75rem; max-width:420px; margin:0 auto;" id="subscribe-form">
  <input name="email" id="email-input" type="email" placeholder="your@email.com" class="email-input" autocomplete="email" required />
  <button type="submit" class="btn-cta" style="width:100%; text-align:center; padding:0.8rem 2rem; cursor:pointer;">
    {{metadata.newsletter.button}}
  </button>
</form>

    <p style="font-family:'Inter',sans-serif; font-size:0.75rem; color:rgba(255,255,255,0.35); margin:1rem 0 0;">
      {{metadata.newsletter.disclaimer}}
    </p>
  </div>
</section>