<section id="book" style="background:#263f4e; padding:3.5rem 2rem;">
  <div style="max-width:1100px; margin:0 auto;">
    <div style="display:grid; grid-template-columns:1fr 320px; gap:4rem; align-items:start;" class="md:grid-cols-2">
      
      <div>
        <p style="font-family:'Inter',sans-serif; font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:#5CA0BF; margin:0 0 0.6rem;">{{book.info}}</p>
        <h2 style="font-family:'Cormorant Garamond',serif; font-size:2rem; font-weight:400; color:#ffffff; margin:0 0 0.75rem; line-height:1.2;">
          <em>{{book.title}}</em><br>
          <span style="font-size:1.4rem; font-weight:300; color:rgba(255,255,255,0.7);">{{book.description}}</span>
        </h2>
        <p style="font-family:'Inter',sans-serif; font-size:0.95rem; line-height:1.75; color:rgba(255,255,255,0.65); max-width:520px; margin:0 0 1.5rem;">
          {{book.text}}
        </p>
        <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
          <a href="{{book.button1.url}}" class="btn-cta">{{book.button1.text}}</a>
          {% for b in book.button_list %}
          <a href="{{b.url}}" class="btn-outline" style="border-color:rgba(255,255,255,0.3); color:rgba(255,255,255,0.7);">{{b.text}}</a>
          {% endfor %}
        </div>
      </div>

      <div>
        <div style="position:relative; padding:20px; margin-bottom:2rem;">
          <div style="position:absolute; top:0; left:0; width:30px; height:30px; border-top:2px solid #F0D478; border-left:2px solid #F0D478;"></div>
          <div style="position:absolute; bottom:0; right:0; width:30px; height:30px; border-bottom:2px solid #F0D478; border-right:2px solid #F0D478;"></div>
          
          <img src="{{book.cover}}" alt="Book Cover" style="width:100%; display:block; box-shadow: 10px 10px 20px rgba(0,0,0,0.3);">
        </div>

        <div class="pull-quote" style="border-color:#5CA0BF; color:rgba(255,255,255,0.85); font-style:italic;">
          "{{book.blockquote.text}}"
        </div>
        <p style="font-family:'Inter',sans-serif; font-size:0.75rem; color:rgba(255,255,255,0.4); margin:0.75rem 0 0; letter-spacing:0.04em;">
          — from <em>{{book.blockquote.info}}</em>
        </p>
      </div>
      
    </div>
  </div>
</section>