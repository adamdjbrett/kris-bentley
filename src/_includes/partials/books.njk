<section id="book" class="bg-[#263f4e] py-12 px-4 md:py-14 md:px-8">
  <div class="max-w-[1100px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-8 lg:gap-16 items-start">
      
      <div>
        <p class="font-sans text-xs tracking-widest uppercase text-[#5CA0BF] mb-2">
          {{book.info}}
        </p>
        <h2 class="font-['Cormorant_Garamond'] text-3xl md:text-4xl font-normal text-white mb-3 leading-tight">
          <em>{{book.title}}</em><br>
          <span class="text-xl md:text-2xl font-light text-white/70">{{book.description}}</span>
        </h2>
        <p class="font-sans text-sm md:text-base leading-relaxed text-white/65 max-w-[520px] mb-6">
          {{book.text}}
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="{{book.button1.url}}" class="btn-cta">{{book.button1.text}}</a>
          {% for b in book.button_list %}
          <a href="{{b.url}}" class="btn-outline border-white/30 text-white/70">{{b.text}}</a>
          {% endfor %}
        </div>
      </div>

      <div>
        <div class="relative p-5 mb-6">
          <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-[#F0D478]"></div>
          <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-[#F0D478]"></div>
          <img src="{{book.cover}}" alt="Book Cover" class="w-full block shadow-2xl">
        </div>

        <div class="border-l-4 border-[#5CA0BF] pl-4 text-white/85 italic font-sans text-sm md:text-base leading-relaxed">
          "{{book.blockquote.text}}"
        </div>
        <p class="font-sans text-xs text-white/40 mt-3 tracking-wide">
          — from <em>{{book.blockquote.info}}</em>
        </p>
      </div>
      
    </div>
  </div>
</section>