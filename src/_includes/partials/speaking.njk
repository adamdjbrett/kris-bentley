<section id="speaking" style="padding:4.5rem 2rem; background:#ffffff; border-top:1px solid #e8eef2;">
  <div style="max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center;">
    <div class="reveal">
      <p style="font-family:'Inter',sans-serif; font-size:0.75rem; letter-spacing:0.1em; text-transform:uppercase; color:#5CA0BF; margin:0 0 0.5rem;">{{speaking.info}}</p>
      <h2 class="section-bracket" style="font-family:'Cormorant Garamond',serif; font-size:2.2rem; font-weight:400; color:#263f4e; margin:0 0 1rem; line-height:1.2;">
        {{speaking.title}}
      </h2>
      <p style="font-family:'Inter',sans-serif; font-size:0.95rem; line-height:1.75; color:#64748b; margin:0 0 1.5rem;">
        {{speaking.description}}
      </p>
      <ul style="list-style:none; padding:0; margin:0 0 1.75rem; display:flex; flex-direction:column; gap:0.75rem;">
        {% for t in speaking.list%}
        <li style="display:flex; align-items:center; gap:0.75rem; font-family:'Inter',sans-serif; font-size:0.875rem; color:#475569;">
          <span style="width:6px; height:6px; border-radius:50%; background:#C26E40; flex-shrink:0;"></span>
          {{t.text}}
        </li>
        {% endfor %}
      </ul>
      <a href="{{speaking.button.url}}" class="btn-cta">{{speaking.button.text}}</a>
    </div>

    <!-- Testimonial -->
    <div class="reveal" style="transition-delay:0.1s;">
      <div style="background:#f8fafc; border-radius:4px; padding:2rem; border:1px solid #e8eef2; position:relative;">
        <!-- Decorative open-quote -->
        <div style="font-family:'Cormorant Garamond',serif; font-size:5rem; line-height:0.7; color:#F0D478; margin-bottom:0.5rem; opacity:0.6;">"</div>
        <p style="font-family:'Cormorant Garamond',serif; font-size:1.2rem; font-style:italic; line-height:1.7; color:#263f4e; margin:0 0 1.25rem;">
          {{speaking.testimonial1.text}}
        </p>
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <div style="width:36px; height:36px; border-radius:50%; background:#375B70; display:flex; align-items:center; justify-content:center; font-family:'Inter',sans-serif; font-size:0.75rem; font-weight:600; color:#F0D478;">{{speaking.testimonial1.short}}</div>
          <div>
            <p style="font-family:'Inter',sans-serif; font-size:0.825rem; font-weight:500; color:#263f4e; margin:0;">{{speaking.testimonial1.name}}</p>
            <p style="font-family:'Inter',sans-serif; font-size:0.75rem; color:#94a3b8; margin:0;">{{speaking.testimonial1.info}}</p>
          </div>
        </div>
      </div>

      <div style="margin-top:1rem; background:#f8fafc; border-radius:4px; padding:2rem; border:1px solid #e8eef2;">
        <div style="font-family:'Cormorant Garamond',serif; font-size:5rem; line-height:0.7; color:#5CA0BF; margin-bottom:0.5rem; opacity:0.5;">"</div>
        <p style="font-family:'Cormorant Garamond',serif; font-size:1.2rem; font-style:italic; line-height:1.7; color:#263f4e; margin:0 0 1.25rem;">
          {{speaking.testimonial2.text}}
        </p>
        <div style="display:flex; align-items:center; gap:0.75rem;">
          <div style="width:36px; height:36px; border-radius:50%; background:#5CA0BF; display:flex; align-items:center; justify-content:center; font-family:'Inter',sans-serif; font-size:0.75rem; font-weight:600; color:#263f4e;">{{speaking.testimonial2.short}}</div>
          <div>
            <p style="font-family:'Inter',sans-serif; font-size:0.825rem; font-weight:500; color:#263f4e; margin:0;">{{speaking.testimonial2.name}}</p>
            <p style="font-family:'Inter',sans-serif; font-size:0.75rem; color:#94a3b8; margin:0;">{{speaking.testimonial2.info}}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
