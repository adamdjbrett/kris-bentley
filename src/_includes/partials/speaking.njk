<section id="speaking" class="py-12 px-4 md:py-16 md:px-8 bg-white border-t border-[#e8eef2]">
  <div class="max-w-[1100px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
    
    <div class="reveal">
      <p class="font-sans text-xs tracking-widest uppercase text-[#5CA0BF] mb-2">
        {{speaking.info}}
      </p>
      <h2 class="font-['Cormorant_Garamond'] text-3xl md:text-4xl font-normal text-[#263f4e] mb-4 leading-tight">
        {{speaking.title}}
      </h2>
      <p class="font-sans text-sm md:text-base leading-relaxed text-[#64748b] mb-6">
        {{speaking.description}}
      </p>
      <ul class="list-none p-0 m-0 mb-7 flex flex-col gap-3">
        {% for t in speaking.list%}
        <li class="flex items-center gap-3 font-sans text-sm text-[#475569]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C26E40] flex-shrink-0"></span>
          {{t.text}}
        </li>
        {% endfor %}
      </ul>
      <a href="{{speaking.button.url}}" class="btn-cta">{{speaking.button.text}}</a>
    </div>

    <div class="reveal space-y-4">
      <div class="bg-[#f8fafc] rounded p-6 md:p-8 border border-[#e8eef2] relative">
        <div class="font-['Cormorant_Garamond'] text-5xl leading-[0.7] text-[#F0D478] mb-2 opacity-60">"</div>
        <p class="font-['Cormorant_Garamond'] text-lg md:text-xl italic leading-relaxed text-[#263f4e] mb-5">
          {{speaking.testimonial1.text}}
        </p>
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-[#375B70] flex items-center justify-center font-sans text-xs font-semibold text-[#F0D478]">
            {{speaking.testimonial1.short}}
          </div>
          <div>
            <p class="font-sans text-sm font-medium text-[#263f4e] m-0">{{speaking.testimonial1.name}}</p>
            <p class="font-sans text-xs text-[#94a3b8] m-0">{{speaking.testimonial1.info}}</p>
          </div>
        </div>
      </div>

      <div class="bg-[#f8fafc] rounded p-6 md:p-8 border border-[#e8eef2]">
        <div class="font-['Cormorant_Garamond'] text-5xl leading-[0.7] text-[#5CA0BF] mb-2 opacity-50">"</div>
        <p class="font-['Cormorant_Garamond'] text-lg md:text-xl italic leading-relaxed text-[#263f4e] mb-5">
          {{speaking.testimonial2.text}}
        </p>
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-[#5CA0BF] flex items-center justify-center font-sans text-xs font-semibold text-[#263f4e]">
            {{speaking.testimonial2.short}}
          </div>
          <div>
            <p class="font-sans text-sm font-medium text-[#263f4e] m-0">{{speaking.testimonial2.name}}</p>
            <p class="font-sans text-xs text-[#94a3b8] m-0">{{speaking.testimonial2.info}}</p>
          </div>
        </div>
      </div>
    </div>
    
  </div>
</section>