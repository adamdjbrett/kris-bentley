<nav style="background:#375B70; position:sticky; top:0; z-index:50; border-bottom:1px solid rgba(255,255,255,0.08);">
  <div style="max-width:1100px; margin:0 auto; padding:0 2rem; display:flex; align-items:center; justify-content:space-between; height:60px;">
    <a href="/" style="text-decoration:none; display:flex; align-items:center; gap:10px;">
      <div style="width:32px; height:32px; border:1.5px solid #F0D478; border-radius:2px; display:flex; align-items:center; justify-content:center;">
        <span style="font-family:'Cormorant Garamond',serif; font-size:1rem; font-weight:600; color:#F0D478; line-height:1;">
          {{metadata.nav.text_logo}}        
        </span>
      </div>
      <span style="font-family:'Inter',sans-serif; font-size:0.85rem; font-weight:500; letter-spacing:0.06em; text-transform:uppercase; color:#ffffff;">{{metadata.nav.title}}</span>
    </a>

    <!-- Desktop Menu: Gunakan class md:flex untuk muncul di desktop -->
    <div style="align-items:center; gap:2rem;" class="hidden md:flex">
      {% for item in metadata.nav.list %}
      <a href="{{ item.url }}" class="nav-link">{{ item.title }}</a>
      {% endfor %}
      <a href="{{ metadata.nav.button.url }}" class="btn-cta" style="padding:0.45rem 1.25rem; font-size:0.8rem;">{{ metadata.nav.button.text }}</a>
    </div>

    <!-- Mobile Hamburger: Hapus style display, gunakan class flex md:hidden -->
    <button onclick="toggleMenu()" id="hamburger" aria-label="Open menu" style="background:none; border:none; cursor:pointer; flex-direction:column; gap:5px; padding:4px;" class="flex md:hidden">
      <span style="display:block; width:22px; height:1.5px; background:#ffffff;"></span>
      <span style="display:block; width:22px; height:1.5px; background:#ffffff;"></span>
      <span style="display:block; width:22px; height:1.5px; background:#ffffff;"></span>
    </button>
  </div>

  <!-- Mobile Menu: Hapus style display:none, gunakan class hidden -->
  <div id="mobile-menu" class="hidden" style="padding:1rem 2rem 1.5rem; border-top:1px solid rgba(255,255,255,0.1);">
    <div style="display:flex; flex-direction:column; gap:1rem;">
      {% for item in metadata.nav.list %}
      <a href="{{ item.url }}" class="nav-link" onclick="toggleMenu()">{{ item.title }}</a>
      {% endfor %}
      <a href="{{ metadata.nav.button.url }}" class="btn-cta" style="padding:0.6rem 1.4rem; margin-top:0.5rem; text-align:center;" onclick="toggleMenu()">{{ metadata.nav.button.text }}</a>
    </div>
  </div>
</nav>