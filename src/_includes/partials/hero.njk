<section id="about" style="background:#375B70; padding:5rem 2rem 4rem;">
  <div style="max-width:1100px; margin:0 auto; display:flex; align-items:center; gap:5rem;" class="hero-grid">

    <!-- Left: text -->
    <div style="flex:1; min-width:0;">
      <p style="font-family:'Inter',sans-serif; font-size:0.78rem; font-weight:500; letter-spacing:0.1em; text-transform:uppercase; color:#5CA0BF; margin:0 0 1.25rem;">{{hero.info}}</p>
      <h1 style="font-family:'Cormorant Garamond',serif; font-size:clamp(2.6rem,5vw,4rem); font-weight:300; line-height:1.1; color:#ffffff; margin:0 0 0.5rem;">
        {{hero.title}}<br>
        <em style="font-style:italic; color:#F0D478;">{{hero.title_info}}</em>
      </h1>

      <div class="divider"></div>

      <p style="font-family:'Inter',sans-serif; font-size:1.05rem; line-height:1.75; color:rgba(255,255,255,0.75); max-width:500px; margin:0 0 2rem;">
        {{hero.text}}
      </p>

      <div style="display:flex; gap:1rem; flex-wrap:wrap;">
        <a href="{{hero.button1.url}}" class="btn-cta">{{hero.button1.text}}</a>
        <a href="{{hero.button2.url}}" class="btn-outline">{{hero.button2.text}}</a>
      </div>

      <!-- Social proof strip -->
      <div style="margin-top:2.5rem; padding-top:2rem; border-top:1px solid rgba(255,255,255,0.12); display:flex; gap:2rem; flex-wrap:wrap;">
        {% for stats in hero.stats %}
        <div>
          <p style="font-family:'Cormorant Garamond',serif; font-size:1.8rem; font-weight:600; color:#F0D478; margin:0; line-height:1;">{{ stats.title }}</p>
          <p style="font-family:'Inter',sans-serif; font-size:0.75rem; color:rgba(255,255,255,0.55); margin:4px 0 0; letter-spacing:0.04em;">{{ stats.text }}</p>
        </div>
        {% endfor %}
      </div>
    </div>

    <!-- Right: book cover with bracket frame -->
    <div class="hero-book" style="flex-shrink:0; display:flex; align-items:center; justify-content:center;">
      <div class="bracket-frame" style="padding:10px;">
        <img
          src="{{hero.image}}"
          alt="{{hero.title}}"
          style="width:220px; display:block; border-radius:2px; box-shadow:0 20px 60px rgba(0,0,0,0.4);"
        />
      </div>
    </div>

  </div>
</section>